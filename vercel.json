{
  "buildCommand": "npm run build --workspace=FRONTEND",
  "outputDirectory": "FRONTEND/dist",
  "installCommand": "npm install --workspace=FRONTEND --include-workspace-root",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-production-f8f9.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
