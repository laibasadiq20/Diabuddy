# Server configuration
PORT=5000

# Frontend URL (used for CORS) — Vercel deployment
CLIENT_URL=https://diabuddy-backend.vercel.app

# Database configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/diabuddy?retryWrites=true&w=majority

# JWT token configuration
JWT_SECRET=add_a_long_random_string_here

# --- Email (pick ONE for Railway) ---
# Railway BLOCKS Gmail SMTP (ports 465/587). Use Resend or Brevo HTTPS API instead.

# Option A — Resend (https://resend.com)  [recommended on Railway]
RESEND_API_KEY=re_xxxxxxxx
# Optional: after verifying a domain on Resend
# EMAIL_FROM=DiaBuddy <noreply@yourdomain.com>
# Until then Resend uses: DiaBuddy <onboarding@resend.dev>

# Option B — Brevo (https://www.brevo.com)
# BREVO_API_KEY=xkeysib-xxxxxxxx
# EMAIL_USER=your_verified_sender@gmail.com

# Option C — Gmail SMTP (local/dev only — does NOT work on Railway)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
