# Server configuration
PORT=5000

# Frontend URL (used for CORS)
CLIENT_URL=https://diabuddy-backend.vercel.app

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/diabuddy?retryWrites=true&w=majority

# JWT
JWT_SECRET=add_a_long_random_string_here

# --- Email ---
# Railway blocks Nodemailer SMTP. Use Apps Script (no domain) OR Brevo.

# Railway (recommended, no domain): Google Apps Script — see EMAIL_SETUP.md
GMAIL_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
GMAIL_SCRIPT_SECRET=pick_a_long_random_secret

# Optional: Brevo HTTPS (verify sender email only, no domain)
# BREVO_API_KEY=xkeysib-xxxxxxxx
# EMAIL_USER=your_verified@gmail.com

# Local only — Nodemailer Gmail SMTP (does NOT work on Railway)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
