# Server configuration
PORT=5000

# Frontend URL (used for CORS)
CLIENT_URL=https://diabuddy-backend.vercel.app

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/diabuddy?retryWrites=true&w=majority

# JWT
JWT_SECRET=add_a_long_random_string_here

# --- Email ---
# Railway blocks Nodemailer SMTP. Use Apps Script (no domain) OR Brevo.

# Railway (recommended, no domain): Google Apps Script — see EMAIL_SETUP.md
GMAIL_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
GMAIL_SCRIPT_SECRET=pick_a_long_random_secret

# Optional: Brevo HTTPS (verify sender email only, no domain)
# BREVO_API_KEY=xkeysib-xxxxxxxx
# EMAIL_USER=your_verified@gmail.com

# Local only — Nodemailer Gmail SMTP (does NOT work on Railway)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# Optional — only needed for Image post uploads (text/poll work without this)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Gemini — AI meal photo analyzer (vision + Pakistani food nutrition lookup)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# New Gemini projects: 2.0/2.5 Flash are blocked — use 3.5 Flash (or gemini-3.6-flash)
GEMINI_MODEL=gemini-3.5-flash

# Web Push (reminder notifications when the browser tab is closed)
# Generate once: npx web-push generate-vapid-keys
# Keep these stable in production (Railway) — regenerating breaks existing subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:support@diabuddy.app

# Google Health API (Fitbit / wearable steps via Google OAuth)
# Create Web client: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local:
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google-health/callback
# Production (Railway) example:
# GOOGLE_REDIRECT_URI=https://backend-production-f8f9.up.railway.app/api/google-health/callback
GOOGLE_HEALTH_SCOPE=https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly

