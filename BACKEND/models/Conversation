const mongoose = require('mongoose');

const conversationSchema = new mongoose.Schema(
  {
    isGroup: {
      type: Boolean,
      default: false,
    },

    name: {
      type: String,
      trim: true,
      maxlength: [100, 'Conversation name cannot exceed 100 characters'],
      // required for group chats (e.g. "Support Group"), unused for 1:1
    },

    members: [
      {
        type: mongoose.Schema.Types.ObjectId,
        ref: 'User',
        required: true,
      },
    ],

    lastMessage: {
      type: mongoose.Schema.Types.ObjectId,
      ref: 'Message',
      default: null,
      // denormalized pointer so the inbox list can render previews without a join
    },

    lastMessageAt: {
      type: Date,
      default: null,
    },
  },
  {
    timestamps: true,
  }
);

// fetch all conversations a user belongs to, sorted by most recent activity
conversationSchema.index({ members: 1, lastMessageAt: -1 });

module.exports = mongoose.model('Conversation', conversationSchema);