const express = require('express');
const router = express.Router();
const { protect } = require('../middleware/auth');
const { rateLimit } = require('../middleware/rateLimit');
const conversationController = require('../controllers/conversationController.js');
const messageController = require('../controllers/messageController');

const dmWriteLimit = rateLimit({ windowMs: 60_000, max: 40, keyPrefix: 'dm-write' });
const dmCreateLimit = rateLimit({ windowMs: 60_000, max: 15, keyPrefix: 'dm-create' });

router.get('/', protect, conversationController.getMyConversations);
router.post('/', protect, dmCreateLimit, conversationController.createConversation);

router.get('/:id', protect, conversationController.getConversationById);
router.patch('/:id', protect, conversationController.updateConversation);
router.post('/:id/members', protect, dmCreateLimit, conversationController.addMembers);
router.delete('/:id/members/:userId', protect, conversationController.removeMember);
router.post('/:id/leave', protect, conversationController.leaveConversation);

router.get('/:id/messages', protect, messageController.getMessages);
router.post('/:id/messages', protect, dmWriteLimit, messageController.sendMessage);
router.put('/:id/read', protect, messageController.markAsRead);

module.exports = router;
