const express = require('express');
const router = express.Router();
const { protect, optionalAuth, adminOnly } = require('../middleware/auth');
const { rateLimit } = require('../middleware/rateLimit');
const postController = require('../controllers/postController.js');
const commentController = require('../controllers/commentController');
const pollController = require('../controllers/pollController.js');

const writeLimit = rateLimit({ windowMs: 60_000, max: 20, keyPrefix: 'posts' });

router.get('/', postController.getFeed);
router.get('/mine/drafts', protect, postController.getMyDrafts);
router.get('/:id', optionalAuth, postController.getPostById);
router.post('/', protect, writeLimit, postController.createPost);
router.put('/:id', protect, writeLimit, postController.updatePost);
router.patch('/:id/moderation', protect, adminOnly, postController.moderatePost);
router.delete('/:id', protect, postController.deletePost);
router.post('/:id/best-answer', protect, postController.setBestAnswer);

// nested comments
router.get('/:postId/comments', commentController.getComments);
router.post('/:postId/comments', protect, writeLimit, commentController.createComment);

// nested poll
router.post('/:postId/poll', protect, writeLimit, pollController.createPoll);
router.get('/:postId/poll', protect, pollController.getPollByPost);

module.exports = router;
